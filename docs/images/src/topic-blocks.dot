digraph topicblocks {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="transparent", pad="0.25", nodesep="0.55", ranksep="0.6"];
  node [shape=box, style="rounded,filled", color="#94a3b8", fontname="Helvetica", fontsize=13, margin="0.18,0.10"];
  edge [color="#94a3b8", fontname="Helvetica", fontsize=12];
  session [label="会话轮次流\n(用户 + 工具 + LLM)", fillcolor="#e0f2fe", shape=cylinder];
  b1 [label="话题块 A\n本块视角摘要版本 · 稳定前缀", fillcolor="#dbeafe"];
  b2 [label="话题块 B\n新摘要版本", fillcolor="#dcfce7"];
  b3 [label="话题块 C …", fillcolor="#fef9c3"];
  tail [label="尾部硬保护\n末 2 个 user 轮原文", fillcolor="#f3e8ff"];
  cache [label="块内前缀稳定 → 云端 prompt 缓存命中", fillcolor="#fef3c7"];
  session -> b1 [label="水位压力分割"];
  b1 -> b2 [label="切换时定级冻结 ACT / REL / FAR"];
  b2 -> b3 [label="块开头注入 reality（本地 4B 拣选）"];
  b3 -> tail [label="尾部"];
  tail -> cache [label="前缀稳定"];
}
