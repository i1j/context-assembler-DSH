{
  "name": "context-assembler-dsh",
  "version": "0.99.0",
  "description": "Context Assembler DSH V0.99 — Context Assembler plugin for DeepSeek Harness (dsh): context compaction, cache-friendly topic-block management, water-pressure topic splitting, tool trace/rewrite, handoff planning and reality recall injection.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ca-db": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/ca-db.js"
    },
    "./topic-state": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/topic-state.js"
    },
    "./handoff-metrics": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/handoff-metrics.js"
    },
    "./handoff-plan": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/handoff-plan.js"
    },
    "./handoff-branch-summary": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/handoff-branch-summary.js"
    },
    "./edge-strength": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/edge-strength.js"
    },
    "./viewpoint": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/viewpoint.js"
    },
    "./route-policy": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/route-policy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "i1j",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i1j/context-assembler-DSH.git"
  },
  "homepage": "https://github.com/i1j/context-assembler-DSH",
  "bugs": {
    "url": "https://github.com/i1j/context-assembler-DSH/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context-assembly",
    "context-compression",
    "context-compaction",
    "topic-management",
    "handoff",
    "memory",
    "reality-injection",
    "tool-trace",
    "上下文汇编"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
